# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site (usado nos redirects do Stripe Checkout / Connect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (reserva / pagamento completo / Connect) — ou guarda em Admin → Definições
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook endpoint: POST /api/stripe/webhook
# Eventos: checkout.session.completed, payment_intent.succeeded, account.updated
STRIPE_WEBHOOK_SECRET=whsec_...

# Necessária para webhooks Connect, splits e criar logins de staff
SUPABASE_SERVICE_ROLE_KEY=

# --- Content automation (blog AI + Meta social) ---
# OpenAI: em Netlify com AI Gateway activo, OPENAI_API_KEY/BASE_URL são injectados.
# Em local, define a tua chave (ou corre `netlify dev` após 1º deploy com AI).
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # opcional; Netlify injecta automaticamente no gateway
CONTENT_OPENAI_MODEL=gpt-4o-mini

# Segredo opcional para cron / automações (Authorization: Bearer …)
CONTENT_API_SECRET=

# Meta Graph API (Instagram Business + Facebook Page)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
