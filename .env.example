# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site (usado nos redirects do Stripe Checkout / Connect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — carrega no layout via Consent Mode v2 (após Aceitar análise).
# Não coloques o snippet gtag em bruto nas páginas; usa só esta env.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QSXD2ED6RD
# Opcional: Google Tag Manager (se usares GTM em vez de/além do gtag directo)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Stripe (reserva / pagamento completo / Connect) — ou guarda em Admin → Definições
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: POST /api/stripe/webhook
# Eventos: checkout.session.completed, payment_intent.succeeded, account.updated
STRIPE_WEBHOOK_SECRET=

# Necessária para webhooks Connect, splits e criar logins de staff
SUPABASE_SERVICE_ROLE_KEY=

# --- Content automation (blog AI + Meta social) ---
# OpenAI: em Netlify com AI Gateway activo, OPENAI_API_KEY/BASE_URL são injectados.
# Em local, define a tua chave (ou corre `netlify dev` após 1º deploy com AI).
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # opcional; Netlify injecta automaticamente no gateway
CONTENT_OPENAI_MODEL=gpt-4o-mini

# Segredo opcional para cron / automações (Authorization: Bearer …)
CONTENT_API_SECRET=

# Meta Graph API (Instagram Business + Facebook Page)
# Token da Página com: pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, pages_show_list
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Script local para obter IDs + Page token:
#   1) Em Meta App → Facebook Login → Settings → Valid OAuth Redirect URIs:
#        http://localhost:3457/callback
#   2) npx tsx scripts/get-meta-ids.ts
#   3) Cola o bloco META_* impresso no terminal neste ficheiro e reinicia next dev

